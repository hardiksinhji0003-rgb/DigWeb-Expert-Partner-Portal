# DigWeb Expert - Partner Portal Environment Variables
# Add these in Netlify Site Settings -> Environment Variables, and in local .env

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Your Supabase Anon Public Key (safe for browser/frontend usage)
# NEVER put service_role key here!
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional app URL for OAuth / password recovery redirect
VITE_APP_URL="https://your-custom-site.netlify.app"
